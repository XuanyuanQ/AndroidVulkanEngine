            <Vertices>
                <Vertex position="0,-0.55,0" color="1,0.2,0.1,1" />
                <Vertex position="0.55,0.45,0" color="0.2,1,0.3,1" />
                <Vertex position="-0.55,0.45,0" color="0.2,0.4,1,1" />
            </Vertices>
        </MeshRenderer>
        <Script class="com.example.trianglegame.PlayerController" />
    </GameObject>
</Scene>
