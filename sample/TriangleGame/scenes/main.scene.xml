<Scene name="TriangleScene">
    <Environment clearColor="0.00,0.00,0.00,0.00" ambientColor="1.00,1.00,1.00,0.00" />

    <GameObject id="MainCamera" name="Main Camera">
        <Transform position="0,2,8" rotation="0,-12,0" scale="1,1,1" />
        <Camera fov="60" near="0.1" far="1000" />
        <Script class="com.example.trianglegame.CameraController"
                modeButton="switch_mode_button"
                translateTexture="textures/tanslate.png"
                rotationTexture="textures/rotation.png" />
    </GameObject>

    <GameObject id="room" name="Viking Room">
        <Transform position="0,0.55,0" rotation="0,0,0" scale="1,1,1" />
        
        <MeshRenderer 
            mesh="meshes/viking_room.obj" 
            baseColorTexture="textures/viking_room.png"
            baseColor="1,1,1,1"
            metallic="0.0"
            roughness="0.65"
            normalScale="1.0"
            visible="true"
            casts_shadow="true"
            receives_shadow="true"/>
    </GameObject>
    
    <GameObject id="Ground" name="Ground">
        <Transform position="0,0,0" rotation="0,0,0" scale="14,1,14" />
        <MeshRenderer 
            mesh="Plane" 
            visible="true"
            casts_shadow="true"
            receives_shadow="true" />
        <!-- <Script class="com.example.trianglegame.PlayerController"/> -->
    </GameObject>

    <GameObject id="forest_tree_back_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-3.84,1.0,-3.04" rotation="0,24,0" scale="1.0,1.0,1.0" />
    </GameObject>

    <GameObject id="forest_tree_back_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="3.92,1.0,-2.80" rotation="0,-18,0" scale="0.95,0.95,0.95" />
    </GameObject>

    <GameObject id="forest_tree_left_mid" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-4.64,1.0,0.64" rotation="0,72,0" scale="1.05,1.05,1.05" />
    </GameObject>

    <GameObject id="forest_tree_right_mid" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="4.48,1.0,0.80" rotation="0,-64,0" scale="0.90,0.90,0.90" />
    </GameObject>

    <GameObject id="forest_tree_front_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-2.96,1.0,3.68" rotation="0,132,0" scale="1.0,1.0,1.0" />
    </GameObject>

    <GameObject id="forest_tree_front_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="3.04,1.0,3.52" rotation="0,-116,0" scale="0.80,0.80,0.80" />
    </GameObject>

    <GameObject id="forest_tree_far_back" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="0.40,1.0,-4.96" rotation="0,8,0" scale="0.70,0.70,0.70" />
    </GameObject>

    <GameObject id="forest_tree_far_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-5.60,1.0,-0.96" rotation="0,48,0" scale="0.72,0.72,0.72" />
    </GameObject>

    <GameObject id="forest_tree_inner_back_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-2.24,1.0,-2.32" rotation="0,-36,0" scale="0.58,0.58,0.58" />
    </GameObject>

    <GameObject id="forest_tree_inner_back_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="2.32,1.0,-2.16" rotation="0,42,0" scale="0.62,0.62,0.62" />
    </GameObject>

    <GameObject id="forest_tree_inner_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-2.56,1.0,1.44" rotation="0,96,0" scale="0.64,0.64,0.64" />
    </GameObject>

    <GameObject id="forest_tree_inner_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="2.48,1.0,1.36" rotation="0,-88,0" scale="0.60,0.60,0.60" />
    </GameObject>

    <GameObject id="forest_tree_front_center_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-1.44,1.0,4.40" rotation="0,154,0" scale="0.66,0.66,0.66" />
    </GameObject>

    <GameObject id="forest_tree_front_center_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="1.52,1.0,4.32" rotation="0,-148,0" scale="0.68,0.68,0.68" />
    </GameObject>

    <GameObject id="forest_tree_far_back_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-4.72,1.0,-4.88" rotation="0,18,0" scale="0.82,0.82,0.82" />
    </GameObject>

    <GameObject id="forest_tree_far_back_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="4.96,1.0,-4.64" rotation="0,-28,0" scale="0.78,0.78,0.78" />
    </GameObject>

    <GameObject id="forest_tree_far_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="5.76,1.0,-0.72" rotation="0,-52,0" scale="0.74,0.74,0.74" />
    </GameObject>

    <GameObject id="forest_tree_front_far_left" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-4.96,1.0,4.64" rotation="0,118,0" scale="0.70,0.70,0.70" />
    </GameObject>

    <GameObject id="forest_tree_front_far_right" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="5.12,1.0,4.48" rotation="0,-128,0" scale="0.76,0.76,0.76" />
    </GameObject>

    <GameObject id="forest_tree_back_center" prefab="prefabs/maple_tree.prefab.xml">
        <Transform position="-1.44,1.0,-4.32" rotation="0,12,0" scale="0.64,0.64,0.64" />
    </GameObject>

    <GameObject id="HierarchyPivot" name="Hierarchy Pivot">
        <Transform position="0,0.5,0" rotation="0,0,0" scale="1,1,1" />
        <Script class="com.example.trianglegame.HierarchyDemoController" speed="35" />

        <GameObject id="InstancedSphere1" prefab="prefabs/my_sphere.prefab.xml">
            <Transform position="2,0,0" />
        </GameObject>

        <GameObject id="InstancedSphere2" prefab="prefabs/my_sphere.prefab.xml">
            <Transform position="-2,0,0" scale="0.5,0.5,0.5" />
        </GameObject>
    </GameObject>

    <GameObject id="ui_room_preview" name="Room Preview">
        <Transform position="0.72,-0.72,0.02" rotation="0,0,0" scale="0.80,0.80,1" />
        <Image texture="textures/viking_room.png" color="1,1,1,0.95" />
    </GameObject>

    <GameObject id="switch_mode_button" name="switch_mode Button">
        <Transform position="0,-0.76,0.01" rotation="0,0,0" scale="0.90,0.45,1" />
        <UILayout size="0.36,0.12" />
        <Image texture="textures/tanslate.png" color="0.2,0.6,1.0,1.0" />
        <Button target="CameraController" onClick="switchMode" />
        <Text value="INTERACT" color="1,0,0,1" size="0.03" />
    </GameObject>

    <GameObject id="ui_health_bar" name="Health Bar">
        <Transform position="-0.48,0.82,0.00" rotation="0,0,0" scale="1.50,1.00,1" />
        <ProgressBar value="0" min="0" max="100" />
    </GameObject>

    <GameObject id="ui_title_text" name="Title Text">
        <Transform position="0,0.92,0.00" rotation="0,0,0" scale="1,1,1" />
        <Text value="VIKING ROOM" color="1,0.95,0.72,1" size="0.08" />
    </GameObject>

    <GameObject id="render_backend_debug_text" name="Render Backend Debug Text">
        <Transform position="0.5,0.82,0.00" rotation="0,0,0" scale="1,1,1" />
        <Text value="RENDER PASS" color="0.65,1.00,0.65,1" size="0.1" />
        <Script class="com.example.trianglegame.RenderBackendDebugText" />
    </GameObject>

    <GameObject id="KeyLight" name="Key Light">
        <Transform position="0,6,6" rotation="0,0,0" scale="1,1,1" />
        <PointLight color="1,0.92,0.72" intensity="15.0" range="20.0" castShadows="true"
                    volumetric="false" volumetricIntensity="1.55" volumetricDensity="0.42" volumetricDecay="0.94" />
        <Script class="com.example.trianglegame.LightControlScript"
                light="KeyLight"
                autoButton="light_auto_button"
                xSlider="light_x_slider"
                ySlider="light_y_slider"
                zSlider="light_z_slider"
                speed="1.15"
                radius="8.0"
                height="3.5"
                heightAmplitude="0.8"
                startAngleDegrees="-55" />
    </GameObject>

    <GameObject id="light_auto_button" name="Light Auto Button">
        <Transform position="-0.72,0.45,0.01" rotation="0,0,0" scale="0.90,0.45,1" />
        <UILayout size="0.36,0.12" />
        <Image texture="textures/viking_room.png" />
        <Button target="LightControlScript" onClick="toggleAuto" />
        <Text value="AUTO ROTATE" color="0,0,1,1" size="0.08" />
    </GameObject>

    <GameObject id="light_x_slider" name="Light X Slider">
        <Transform position="-0.72,0.15,0.01" rotation="0,0,0" scale="0.90,0.30,1" />
        <UILayout size="0.52,0.08" />
        <Slider value="0" min="-8" max="8" target="LightControlScript" onValueChanged="setLightAxis" />
        <Text value="LIGHT X" color="1,1,1,1" size="0.02" />
    </GameObject>

    <GameObject id="light_y_slider" name="Light Y Slider">
        <Transform position="-0.72,-0.15,0.01" rotation="0,0,0" scale="0.90,0.30,1" />
        <UILayout size="0.52,0.08" />
        <Slider value="6" min="0.5" max="10" target="LightControlScript" onValueChanged="setLightAxis" />
        <Text value="LIGHT Y" color="1,1,1,1" size="0.02" />
    </GameObject>

    <GameObject id="light_z_slider" name="Light Z Slider">
        <Transform position="-0.72,-0.45,0.01" rotation="0,0,0" scale="0.90,0.30,1" />
        <UILayout size="0.52,0.08" />
        <Slider value="6" min="-8" max="8" target="LightControlScript" onValueChanged="setLightAxis" />
        <Text value="LIGHT Z" color="1,1,1,1" size="0.02" />
    </GameObject>

    <GameObject id="MySpawner" name="My Spawner">
        <Transform position="0,0,0" rotation="0,0,0" scale="1,1,1" />
        <Script class="com.example.trianglegame.MySpawner"
                prefab="prefabs/my_sphere.prefab.xml"
                spawnScale="1.0"
                spawnPositions="-6.0,3.0,0.0;-3.0,3.0,0.0;0.0,3.0,0.0;3.0,3.0,0.0;6.0,3.0,0.0" />
    </GameObject>

    <GameObject id="spawn_hero_button" name="Spawn Hero Button">
        <Transform position="0.72,0.45,0.01" rotation="0,0,0" scale="0.90,0.45,1" />
        <UILayout size="0.36,0.12" />
        <Image texture="textures/tanslate.png" color="0.1,0.8,0.2,1.0" />
        <Button target="MySpawner" onClick="spawnDynamicObject" />
        <Text value="SPAWN HERO" color="1,1,1,1" size="0.03" />
    </GameObject>
</Scene>
